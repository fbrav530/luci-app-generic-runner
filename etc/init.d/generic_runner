#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
    local enabled bin_path extra_args log_path
    
    # 固定的配置文件名 main
    config_load 'generic_runner'
    config_get_bool enabled 'main' 'enabled' 0
    config_get bin_path 'main' 'bin_path' ''
    config_get extra_args 'main' 'extra_args' ''
    config_get log_path 'main' 'log_path' '/var/log/generic_runner.log'

    [ "$enabled" -eq 1 ] || return 0
    [ -f "$bin_path" ] || { echo "错误: 找不到二进制文件 $bin_path"; return 1; }

    procd_open_instance
    procd_set_param command "$bin_path"
    
    # 将用户输入的自定义参数分割并传入
    for arg in $extra_args; do
        procd_append_param command "$arg"
    done

    # 权限与自动重启设置
    procd_set_param respawn
    
    # stdout 和 stderr 日志重定向到用户指定的日志文件
    procd_set_param stdout 1
    procd_set_param stderr 1
    # 如果程序自身不支持写日志，用这一行强制捕获输出到文件
    # 注意：某些旧版OpenWrt可能需要通过 sh -c 包装来实现输出重定向
    
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "generic_runner"
}
