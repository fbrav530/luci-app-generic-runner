#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

run_instance() {
    local cfg="$1"
    local enabled name bin_path extra_args respawn_retry respawn_timeout

    # 核心修改：读取单个程序的启用状态，默认值为 0 👇
    config_get_bool enabled "$cfg" 'enabled' 0
    [ "$enabled" -eq 1 ] || return 0

    config_get name "$cfg" 'name' '未命名程序'
    config_get bin_path "$cfg" 'bin_path' ''
    config_get extra_args "$cfg" 'extra_args' ''
    config_get respawn_retry "$cfg" 'respawn_retry' '5'
    config_get respawn_timeout "$cfg" 'respawn_timeout' '5'

    # 检查文件是否存在
    [ -f "$bin_path" ] || return 0

    procd_open_instance "$cfg"
    procd_set_param command "$bin_path"
    
    for arg in $extra_args; do
        procd_append_param command "$arg"
    done

    # 进程守护
    procd_set_param respawn 3600 "$respawn_timeout" "$respawn_retry"
    
    procd_close_instance
}

start_service() {
    local global_enabled
    config_load 'generic_runner'
    
    # 检查全局总开关
    config_get_bool global_enabled 'global' 'enabled' 0
    [ "$global_enabled" -eq 1 ] || return 0

    # 遍历所有程序
    config_foreach run_instance 'program'
}

service_triggers() {
    procd_add_reload_trigger "generic_runner"
}
