#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
    local enabled bin_path extra_args log_path
    
    config_load 'generic_runner'
    config_get_bool enabled 'main' 'enabled' 0
    config_get bin_path 'main' 'bin_path' ''
    config_get extra_args 'main' 'extra_args' ''
    config_get log_path 'main' 'log_path' '/var/log/generic_runner.log'

    [ "$enabled" -eq 1 ] || return 0
    [ -f "$bin_path" ] || { echo "错误: 找不到二进制文件 $bin_path"; return 1; }

    # 确保日志文件所在的目录存在
    mkdir -p "$(dirname "$log_path")"

    procd_open_instance
    
    # 核心修改：通过 sh -c 运行程序，并将直接打印的 stdout 和 stderr 重定向追加（>>）到日志文件
    procd_set_param command /bin/sh -c "$bin_path $extra_args >> $log_path 2>&1"

    # 允许程序崩溃后自动重启
    procd_set_param respawn
    
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "generic_runner"
}
